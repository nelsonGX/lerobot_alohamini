#!/usr/bin/env bash
# Run on the GPU server; connect through the panel's Train & Eval page.
set -euo pipefail
cd "$(dirname "$0")"
exec uv run --no-sync --with 'fastapi>=0.115' --with 'uvicorn[standard]>=0.30' \
  uvicorn --app-dir lerobot-panel/server gpu_agent:app --host 0.0.0.0 --port "${GPU_AGENT_PORT:-8766}"
