#!/usr/bin/env bash
# Train on the GPU server, pulling the dataset from the HF Hub and pushing the policy back.
# Usage: ./train_remote <hf_user>/<dataset_name> <hf_user>/<policy_name> [policy_type=act] [extra lerobot-train args...]
set -euo pipefail
DATASET="${1:?usage: ./train_remote <dataset_repo> <policy_repo> [policy_type] [extra args]}"
POLICY_REPO="${2:?missing policy repo}"
POLICY_TYPE="${3:-act}"
shift $(( $# < 3 ? $# : 3 ))
uv run lerobot-train \
  --dataset.repo_id="$DATASET" \
  --policy.type="$POLICY_TYPE" \
  --policy.device=cuda \
  --policy.push_to_hub=true \
  --policy.repo_id="$POLICY_REPO" \
  --output_dir="outputs/train/$(basename "$POLICY_REPO")" \
  "$@"
