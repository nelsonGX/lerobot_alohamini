#!/usr/bin/env bash
# Push an already-recorded local dataset to the HF Hub (run on the Jetson).
# Usage: ./push_dataset <hf_user>/<dataset_name> [--public]
set -euo pipefail
REPO_ID="${1:?usage: ./push_dataset <hf_user>/<dataset_name> [--public]}"
PRIVATE=True; [[ "${2:-}" == "--public" ]] && PRIVATE=False
uv run python - "$REPO_ID" "$PRIVATE" <<'PY'
import sys
from lerobot.datasets.lerobot_dataset import LeRobotDataset
LeRobotDataset(sys.argv[1]).push_to_hub(private=sys.argv[2] == "True")
PY
